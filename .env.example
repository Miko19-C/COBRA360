# Docker Compose lee este archivo si lo copias como .env.
# Spring Boot lee las variables del proceso; usa iniciar.ps1 para cargar .env.
DB_URL=jdbc:mysql://localhost:3308/cobra360?serverTimezone=America/Lima&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=cobra360
DB_PASSWORD=cobra360_local
MYSQL_ROOT_PASSWORD=root_local_only
SPRING_PROFILES_ACTIVE=demo
SERVER_PORT=8080
